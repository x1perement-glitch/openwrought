{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/x1perement-glitch/openwrought/schemas/source-provenance-mark-002.schema.json",
  "title": "Openwrought Source Provenance Mark 002",
  "description": "Experimental claim-level provenance record after SPM 0.1 stress testing.",
  "type": "object",
  "required": ["version", "transformation", "reasoning", "claim_ai_role", "claim_validation", "sources"],
  "properties": {
    "version": {"const": "0.2"},
    "transformation": {"enum": ["observation", "quote", "paraphrase", "synthesis"]},
    "reasoning": {"enum": ["none", "inference"]},
    "claim_ai_role": {"enum": ["none-declared", "assisted", "generated", "unknown"]},
    "claim_validation": {"enum": ["unvalidated", "corroborated", "tested"]},
    "validation_method": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "class", "source_ai_status", "source_check"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "class": {"enum": ["primary", "secondary", "tertiary", "unknown"]},
          "source_ai_status": {"enum": ["human-declared", "ai-declared", "mixed-declared", "unknown"]},
          "source_check": {"enum": ["unlocated", "located", "content-checked"]},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "timestamp": {"type": "string"},
    "author_operator": {"type": "string"},
    "note": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"claim_validation": {"const": "tested"}}, "required": ["claim_validation"]},
      "then": {"required": ["validation_method"]}
    }
  ],
  "additionalProperties": false
}
