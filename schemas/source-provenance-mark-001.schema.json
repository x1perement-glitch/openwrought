{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/x1perement-glitch/openwrought/schemas/source-provenance-mark-001.schema.json",
  "title": "Openwrought Source Provenance Mark 001",
  "description": "Experimental machine-readable companion to the human-readable SPM 0.1 notation.",
  "type": "object",
  "required": ["version", "source_class", "relation", "ai_role", "verification", "sources"],
  "properties": {
    "version": {"const": "0.1"},
    "source_class": {
      "oneOf": [
        {"enum": ["primary", "secondary", "tertiary", "unknown"]},
        {
          "type": "array",
          "items": {"enum": ["primary", "secondary", "tertiary", "unknown"]},
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "relation": {"enum": ["observation", "quote", "paraphrase", "synthesis", "inference"]},
    "ai_role": {"enum": ["none-declared", "assisted", "generated", "unknown"]},
    "verification": {"enum": ["unverified", "located", "checked", "corroborated", "tested"]},
    "sources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "timestamp": {"type": "string"},
    "author_operator": {"type": "string"},
    "note": {"type": "string"}
  },
  "additionalProperties": false
}
